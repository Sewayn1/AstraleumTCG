  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Souveraine oubli\xE9e des abysses, Thalyra dort au fond de l'oc\xE9an
    depuis que les hommes ont cess\xE9 de croire en elle. Son c\u0153ur bat au rythme
    des mar\xE9es \u2014 calme et imp\xE9n\xE9trable \xE0 mar\xE9e haute, d\xE9cha\xEEn\xE9e
    et impitoyable \xE0 mar\xE9e basse. Ceux qui l'affrontent doivent apprendre \xE0
    lire l'oc\xE9an, ou s'y noyer."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 30774a0c212cf404ab5e09c25a304591, type: 2}
