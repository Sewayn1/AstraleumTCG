{
  "name": "astraleum-launcher",
  "version": "1.4.0",
  "description": "Astraleum TCG Game Launcher",
  "author": "Sewayn1",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "gen-manifest": "node tools/generate-manifest.js"
  },
  "dependencies": {
    "adm-zip": "^0.5.10"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
    "dotenv": "^17.4.2",
    "electron": "^28.3.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.astraleum.launcher",
    "productName": "Astraleum Launcher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "img/**/*",
      "launcher.config.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "img/logo2.png",
      "artifactName": "AstraleumLauncher-Setup-${version}.exe",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Astraleum Launcher"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "img/logo2.png"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "img/logo2.png"
    }
  }
}
